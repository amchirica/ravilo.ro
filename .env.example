# Copiază în .env.local și completează cheile din Supabase Dashboard → Settings → API.

NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=dev-only-ravilo-auth-secret-change-me-32+

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opțional: doar pentru npm run db:migrate (URI direct din Settings → Database, NU localhost)
DATABASE_DIRECT_URL=

PAYMENT_PROVIDER=mock
# Localhost: doar chei de TEST. Live (sk_live_) este blocat în development.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Producție (NODE_ENV=production, APP_URL=https://ravilo.ro):
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (Stripe Dashboard → Webhooks → endpoint https://ravilo.ro/api/webhooks/stripe)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# AUTH_SECRET=                       (minim 32 caractere, nu default-ul de dev)
# CRON_SECRET=                       (Bearer pentru /api/cron/reservations și /api/cron/email)
EMAIL_PROVIDER=console
ALLOW_DEV_SEED=true
ALLOW_CREATE_SUPER_ADMIN=false

# Temporar, doar pentru `npm run bootstrap-admin`. Șterge-le după.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
