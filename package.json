{
  "name": "ravilo.ro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rimraf .next && next dev",
    "dev:webpack": "next dev --webpack",
    "build": "opennextjs-cloudflare build && node scripts/strip-og-wasm.mjs",
    "build:next": "next build",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "cf:build": "npm run build",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:placeholders": "tsx scripts/write-placeholders.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "security:audit": "npm audit --omit=dev",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
