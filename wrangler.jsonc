{
  // Workers Builds: Build = `npm run build`, Deploy = `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravilo-ro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ravilo-ro"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "alias": {
    "next/dist/compiled/@vercel/og": "./cloudflare/og-stub.js",
    "next/dist/compiled/@vercel/og/index.edge.js": "./cloudflare/og-stub.js",
    "next/dist/compiled/@vercel/og/index.node.js": "./cloudflare/og-stub.js"
  }
}
