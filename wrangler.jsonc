{
  // Workers Builds can keep Build = `npm run build` and Deploy = `npx wrangler deploy`.
  // `npm run build` runs OpenNext; wrangler then calls `opennextjs-cloudflare deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravilo-ro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ravilo-ro"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
