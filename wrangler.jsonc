{
  // Workers Builds: set Build to `npx @opennextjs/cloudflare build`
  // and Deploy to `npx @opennextjs/cloudflare deploy`.
  // `npm run build` + `npx wrangler deploy` cannot deploy this Next.js app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravilo-ro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ravilo-ro"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
